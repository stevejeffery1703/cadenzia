{
  // Cadenzia — Cloudflare Worker config.
  // The Worker serves the built React app (dist/) and handles /api/* routes.
  "name": "focus-music-app",
  "main": "src/worker/index.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],

  // Persists console.error/log output so failed requests are queryable in the
  // dashboard after the fact, not just visible while `wrangler tail` is running.
  "observability": {
    "enabled": true
  },

  "vars": {
    // ⚠️ PRE-LAUNCH PAYMENTS KILL SWITCH — deliberately "false".
    // Cadenzia is still in development (the piano catalogue is being recorded),
    // so nothing may take money yet. While this is off, POST
    // /api/subscription/checkout refuses to create a Stripe Checkout Session and
    // returns 503, regardless of what the client sends. This is the real guard;
    // the client's VITE_PAYMENTS_ENABLED only hides the buttons.
    // TO GO LIVE: set this to "true" AND build with VITE_PAYMENTS_ENABLED=true.
    // Do not flip it before working through docs/go-live-checklist.md — the
    // Stripe account was replaced in July 2026 and its full setup (keys, price,
    // webhook, Managed Payments, tax code) must be redone and re-verified first.
    "PAYMENTS_ENABLED": "false"
  },

  // Serve the Vite build output as static assets. run_worker_first: true so
  // every request reaches the Worker before falling back to static serving —
  // needed for two things in src/worker/index.js: reporting a real 404 for
  // genuinely unmatched paths (Cloudflare's SPA fallback otherwise serves
  // index.html with 200 OK for anything, a soft 404), and rewriting each
  // known route's meta tags. Scoping this to an array of just the HTML
  // routes was tried and rejected — empirically, any path NOT in that array
  // stopped reaching the Worker at all, silently breaking the 404 fix for
  // unlisted paths. The boolean form costs a small per-request overhead
  // (every JS/CSS/image request also invokes the Worker) in exchange for
  // both fixes actually working.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  // Audio masters live in R2 and are streamed ONLY through the Worker (/audio/*),
  // which cookie-gates each request. The bucket must NOT have public access
  // (no r2.dev URL / public custom domain) or that gate is bypassable.
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "focus-music-audio"
    }
  ],

  // Session timing, share tokens, rate limiting.
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "16841f4832a946cda00ddd158c6c8ace"
    }
  ],

  // Users, subscriptions, email list, listening stats, play counter.
  // Schema lives in migrations/ (applied via `wrangler d1 migrations apply`).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cadenzia-db",
      "database_id": "b883ed87-96e1-4e9e-b6a3-160649bb03a9"
    }
  ],

  // Custom domain — Cloudflare provisions the DNS record automatically
  // since the zone is on this account.
  "routes": [
    {
      "pattern": "cadenzia.app",
      "custom_domain": true
    }
  ]

  // Secrets (set with `wrangler secret put NAME`, never commit):
  //   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_ID,
  //   RESEND_API_KEY, APP_URL, JWT_SECRET
  //   ADMIN_EMAIL — optional. The owner's sign-in email; unlocks the private
  //     stats panel on /account (GET /api/admin/stats). Unset = route 404s for
  //     everyone, so it can never fall open.
  // Managed Payments (merchant of record) is always on in code — no flag.
}
